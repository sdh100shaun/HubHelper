{
  "name": "@sdh100shaun/hubhelper",
  "version": "1.0.0",
  "description": "AI-powered tools to visualize GitHub activity and flag security issues across organizations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hubhelper": "dist/index.js"
  },
  "workspaces": [
    "website"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:build": "cd website && npm run build",
    "docs:start": "cd website && npm run start",
    "docs:serve": "cd website && npm run serve",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "prepublishOnly": "npm run lint && npm run build",
    "docs:validate": "cd website && npm run validate",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "github",
    "copilot",
    "security",
    "monitoring",
    "ai",
    "github-actions",
    "security-scanner",
    "cli",
    "developer-tools"
  ],
  "author": "sdh100shaun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdh100shaun/gh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sdh100shaun/gh-tools/issues"
  },
  "homepage": "https://github.com/sdh100shaun/gh-tools#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.34",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "ora": "^10.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "glob": "^14.0.6",
    "inflight": "npm:lru-cache@^10.4.3",
    "minimatch": "^11.0.9",
    "brace-expansion": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@babel/core": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-dynamic-import": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.14",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.6.9",
    "@playwright/test": "^1.65.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "jest": "^30.5.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
