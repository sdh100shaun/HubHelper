{
  "name": "@sdh100shaun/hubhelper",
  "version": "1.0.0",
  "description": "AI-powered tools to visualize GitHub activity and flag security issues across organizations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hubhelper": "dist/index.js"
  },
  "workspaces": [
    "website"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:build": "cd website && npm run build",
    "docs:start": "cd website && npm run start",
    "docs:serve": "cd website && npm run serve",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm test && npm run test:e2e",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "github",
    "copilot",
    "security",
    "monitoring",
    "ai",
    "github-actions",
    "security-scanner",
    "cli",
    "developer-tools"
  ],
  "author": "sdh100shaun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdh100shaun/gh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sdh100shaun/gh-tools/issues"
  },
  "homepage": "https://github.com/sdh100shaun/gh-tools#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "ora": "^9.4.1",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "glob": "^10.4.5",
    "inflight": "npm:lru-cache@^10.4.3",
    "minimatch": "^10.2.5",
    "brace-expansion": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^26.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3"
  }
}
