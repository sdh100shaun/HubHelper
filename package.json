{
  "name": "@sdh100shaun/gh-security-tools",
  "version": "1.0.0",
  "description": "AI-powered tools to visualize GitHub activity and flag security issues across organizations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "gh-security": "dist/index.js",
    "gh-security-tools": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "sbom.json"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "sbom:generate": "cyclonedx-npm --output-file sbom.json --spec-version 1.6 --short-PURLs",
    "sbom:generate:xml": "cyclonedx-npm --output-file sbom.xml --spec-version 1.6 --output-format XML",
    "sbom:all": "npm run sbom:generate && npm run sbom:generate:xml",
    "commitlint": "commitlint --edit",
    "commitlint:last": "commitlint --from=HEAD~1",
    "commitlint:all": "commitlint --from=origin/main",
    "commit:validate": "commitlint --from=HEAD~1 --to=HEAD --verbose",
    "hooks:install": "node scripts/install-git-hooks.js",
    "hooks:uninstall": "node scripts/uninstall-git-hooks.js",
    "prepublishOnly": "npm run lint && npm run build && npm run sbom:generate"
  },
  "keywords": [
    "github",
    "copilot",
    "security",
    "monitoring",
    "ai",
    "github-actions",
    "security-scanner",
    "cli",
    "developer-tools"
  ],
  "author": "sdh100shaun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdh100shaun/gh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sdh100shaun/gh-tools/issues"
  },
  "homepage": "https://github.com/sdh100shaun/gh-tools#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.13",
    "@octokit/rest": "^20.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@cyclonedx/cyclonedx-npm": "^4.1.2",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
