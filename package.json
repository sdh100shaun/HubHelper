{
  "name": "@sdh100shaun/hubhelper",
  "version": "1.0.0",
  "description": "AI-powered tools to visualize GitHub activity and flag security issues across organizations",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "hubhelper": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:build": "eleventy",
    "docs:serve": "eleventy --serve",
    "docs:watch": "eleventy --watch",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "github",
    "copilot",
    "security",
    "monitoring",
    "ai",
    "github-actions",
    "security-scanner",
    "cli",
    "developer-tools"
  ],
  "author": "sdh100shaun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sdh100shaun/gh-tools.git"
  },
  "bugs": {
    "url": "https://github.com/sdh100shaun/gh-tools/issues"
  },
  "homepage": "https://github.com/sdh100shaun/gh-tools#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.2.2",
    "@octokit/rest": "^20.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "ora": "^8.0.1",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "glob": "^10.4.5",
    "inflight": "npm:lru-cache@^10.4.3"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@biomejs/biome": "^1.5.3",
    "@types/jest": "^29.5.11",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.19.39",
    "jest": "^29.7.0",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
