{
  "name": "gh-tools",
  "version": "1.0.0",
  "description": "AI-powered tools to visualize GitHub activity and flag security issues across organizations",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format --write .",
    "test": "jest"
  },
  "keywords": [
    "github",
    "copilot",
    "security",
    "monitoring",
    "ai"
  ],
  "author": "sdh100shaun",
  "license": "MIT",
  "dependencies": {
    "@github/copilot-sdk": "^0.1.13",
    "@octokit/rest": "^20.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "dotenv": "^16.4.1",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
