<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="Content-Security-Policy"
          content="default-src 'self';
                   style-src 'self' 'unsafe-inline';
                   script-src 'self';
                   img-src 'self' data: https:;
                   font-src 'self';
                   connect-src 'self';">
    <title>{% if title %}{{ title }} - {% endif %}HubHelper Documentation</title>
    <meta name="description" content="{{ description or 'AI-powered tools to visualize GitHub activity and flag security issues across organizations' }}">

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="{{ '/images/favicon.svg' | url }}">

    <!-- Styles -->
    <link rel="stylesheet" href="{{ '/css/main.css' | url }}">

    <!-- Open Graph -->
    <meta property="og:title" content="{{ title or 'HubHelper' }}">
    <meta property="og:description" content="{{ description or 'AI-powered tools to visualize GitHub activity and flag security issues' }}">
    <meta property="og:type" content="website">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or 'HubHelper' }}">
    <meta name="twitter:description" content="{{ description or 'AI-powered security analysis for GitHub organizations' }}">
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <header class="site-header">
        <div class="container">
            <nav class="main-nav" aria-label="Main navigation">
                <div class="nav-brand">
                    <a href="{{ '/' | url }}" class="brand-link">
                        <span class="brand-icon">🔐</span>
                        <span class="brand-text">HubHelper</span>
                    </a>
                </div>

                <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false">
                    <span class="hamburger"></span>
                </button>

                <ul class="nav-menu">
                    <li><a href="{{ '/' | url }}" {% if page.url == "/" %}aria-current="page"{% endif %}>Home</a></li>
                    <li><a href="{{ '/pages/getting-started/' | url }}" {% if page.url.startsWith('/pages/getting-started') %}aria-current="page"{% endif %}>Getting Started</a></li>
                    <li><a href="{{ '/pages/api/' | url }}" {% if page.url.startsWith('/pages/api') %}aria-current="page"{% endif %}>API Reference</a></li>
                    <li><a href="{{ '/pages/security/' | url }}" {% if page.url.startsWith('/pages/security') %}aria-current="page"{% endif %}>Security</a></li>
                    <li><a href="{{ '/pages/contributing/' | url }}" {% if page.url.startsWith('/pages/contributing') %}aria-current="page"{% endif %}>Contributing</a></li>
                    <li><a href="https://github.com/sdh100shaun/gh-tools" target="_blank" rel="noopener" class="github-link">
                        <svg aria-hidden="true" height="20" viewBox="0 0 16 16" width="20">
                            <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
                        </svg>
                        GitHub
                    </a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main id="main-content" class="site-main">
        {{ content | safe }}
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-section">
                    <h3>HubHelper</h3>
                    <p>AI-powered security analysis for GitHub organizations</p>
                </div>

                <div class="footer-section">
                    <h4>Documentation</h4>
                    <ul>
                        <li><a href="{{ '/pages/getting-started/' | url }}">Getting Started</a></li>
                        <li><a href="{{ '/pages/api/' | url }}">API Reference</a></li>
                        <li><a href="{{ '/pages/security/' | url }}">Security</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Community</h4>
                    <ul>
                        <li><a href="{{ '/pages/contributing/' | url }}">Contributing</a></li>
                        <li><a href="https://github.com/sdh100shaun/gh-tools" target="_blank" rel="noopener">GitHub Repository</a></li>
                        <li><a href="https://github.com/sdh100shaun/gh-tools/issues" target="_blank" rel="noopener">Report Issues</a></li>
                    </ul>
                </div>

                <div class="footer-section">
                    <h4>Resources</h4>
                    <ul>
                        <li><a href="https://www.npmjs.com/package/@sdh100shaun/hubhelper" target="_blank" rel="noopener">npm Package</a></li>
                        <li><a href="https://github.com/github/copilot-sdk" target="_blank" rel="noopener">GitHub Copilot SDK</a></li>
                    </ul>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; {% year %} HubHelper. Licensed under MIT.</p>
                <p>Built with <a href="https://www.11ty.dev/" target="_blank" rel="noopener">Eleventy</a></p>
            </div>
        </div>
    </footer>

    <script src="{{ '/js/main.js' | url }}"></script>
</body>
</html>
