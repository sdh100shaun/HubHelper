# ─── Option 0: GitHub CLI (no token needed) ──────────────────────────────────
# If you have run `gh auth login`, leave GITHUB_TOKEN unset and HubHelper will
# borrow the CLI's credential. Verify with: hubhelper auth status --org <org>
#
# HUBHELPER_NO_GH_CLI=1    # disable GitHub CLI discovery entirely

# ─── Option 1: Personal Access Token ─────────────────────────────────────────
# Required scopes: repo, read:org. Repository admin is additionally needed for
# accurate actions_enabled / security_enabled reporting.
GITHUB_TOKEN=your_github_token_here

# ─── Option 2: GitHub App ─────────────────────────────────────────────────────
# Use a GitHub App instead of a PAT for automated / CI workflows.
# When GITHUB_APP_ID is present it takes precedence over GITHUB_TOKEN.
#
# GITHUB_APP_ID=123456
# GITHUB_APP_INSTALLATION_ID=78901234
#
# Provide the private key either as inline PEM content …
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
#
# … or as a path to the .pem file:
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/private-key.pem

# ─── Organization ─────────────────────────────────────────────────────────────
GITHUB_ORG=your_organization_name
